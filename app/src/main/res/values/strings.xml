    <string name="about_feature_connections">VLESS connections with QR code scanning and clipboard import</string>
    <string name="about_feature_routing">Separate routing rules for applications and websites</string>
    <string name="about_feature_automation">Automatic VPN control for mobile data and trusted or untrusted Wi-Fi</string>
